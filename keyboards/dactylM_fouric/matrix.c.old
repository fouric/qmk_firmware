inline bool matrix_is_on(uint8_t row, uint8_t col) { return (matrix[row] & ((matrix_row_t)1 << col)); } // ergodox_ez
inline matrix_row_t matrix_get_row(uint8_t row) { return matrix[row]; }	// ergodox_ez

void matrix_init(void) {
  // initialize row and col

  // mcp23018_status = init_mcp23018();

  unselect_cols();
  init_rows();

  // initialize matrix state: all keys off
  for (uint8_t i = 0; i < MATRIX_ROWS; i++) {
    matrix[i]     = 0;
    raw_matrix[i] = 0;
  }

  debounce_init(MATRIX_ROWS);
  matrix_init_quantum();
}

// Reads and stores a column, returning
// whether a change occurred.
static inline bool store_raw_matrix_col(uint8_t index) {
  matrix_row_t temp = read_rows(index);
  if (raw_matrix[index] != temp) {
    raw_matrix[index] = temp;
    return true;
  }
  return false;
}

uint8_t matrix_scan(void) {
  bool changed = false;
  for (uint8_t i = 0; i < MATRIX_COLS; i++) {
     // select columns from left & right hands
    uint8_t left_index = i;
    //uint8_t right_index = i + MATRIX_COLS_PER_SIDE;
    select_col(left_index);
	wait_us(50);
    //select_col(right_index);

    // we don't need a 30us delay anymore, because selecting a
    // left-hand row requires more than 30us for i2c.

    changed |= store_raw_matrix_col(left_index);
	
    //changed |= store_raw_matrix_col(right_index);

    unselect_cols();
  }

  debounce(raw_matrix, matrix, MATRIX_ROWS, changed); 
  matrix_scan_quantum(); // ultimately calls matrix_scan_kb()

	if (changed) 
	{
		// Toggle debug LED
		PORTB = PORTB ^ 0x01;
		matrix_print();
	}


  return 1;
}


void matrix_print(void) { // ergodox_ez
  print("\nr/c 0123456789ABCDEF\n");
  for (uint8_t row = 0; row < MATRIX_ROWS; row++) {
    phex(row);
    print(": ");
    pbin_reverse16(matrix_get_row(row));
    print("\n");
  }
}



void matrix_power_up(void) {
  //mcp23018_status = init_mcp23018();

  unselect_cols();
  init_rows();

  // initialize matrix state: all keys off
  for (uint8_t i = 0; i < MATRIX_ROWS; i++) {
    matrix[i] = 0;
  }
}

__attribute__((weak)) void matrix_init_user(void) {}

__attribute__((weak)) void matrix_scan_user(void) {}

__attribute__((weak)) void matrix_init_kb(void) { matrix_init_user(); }

__attribute__((weak)) void matrix_scan_kb(void) { matrix_scan_user(); }

inline uint8_t matrix_rows(void) { return MATRIX_ROWS; }

inline uint8_t matrix_cols(void) { return MATRIX_COLS; }

/* Rows pin configuration (dactyl's )
 *
 * Teensy
 * row: 0   1   2   3   4  
 * pin: F0  F1  F4  F5  F6
 *
 * MCP23018
 * row: 0   1   2   3   4   5
 * pin: ~B5  B4  B3  B2  B1  B0~
 */
static void init_rows(void) {
	// init on mcp23018
	// not needed, already done as part of init_mcp23018()

	// init on teensy
	// Input (DDR:0, PORT:0)
	DDRF  &= ~(1 << 6 | 1 << 5 | 1 << 4 | 1 << 1 | 1 << 0); // input
	PORTF &= ~(1 << 6 | 1 << 5 | 1 << 4 | 1 << 1 | 1 << 0); // non-pullup
	
	// Turn on debug LED
	DDRB |= 0x01; // OUTPUT
	PORTB |= 0x01; // HIGH
}

static matrix_col_t read_rows(uint8_t col) {
  if (col < 0) {/*
    if (mcp23018_status) {  // if there was an error
      return 0;
    } else {
      uint8_t data    = 0;
      // reading GPIOB (column port) since in mcp23018's sequential mode
      // it is addressed directly after writing to GPIOA in select_row()
      mcp23018_status = i2c_start(I2C_ADDR_READ, ERGODOX_EZ_I2C_TIMEOUT);
      if (mcp23018_status) goto out;
      mcp23018_status = i2c_read_nack(ERGODOX_EZ_I2C_TIMEOUT);
      if (mcp23018_status < 0) goto out;
      data            = ~((uint8_t)mcp23018_status);
      mcp23018_status = I2C_STATUS_SUCCESS;
    out:
      i2c_stop();
      return data;
    }*/
  } else {
    /* read from teensy
 * Teensy
 * row: 0   1   2   3   4  
 * pin: F0  F1  F4  F5  F6
	bitmask is 0b01110011
	*/

    //return ~((PINF & 0x03) | ((PINF & 0xF0) >> 2));
	// bits are: 0b0111_0011
	return (((PINF & 0x70) >> 2) | (PINF & 0x03));
  }
}

/* Column pin configuration (dactyl's) 
 *
 * Teensy
 * col: 0   1   2   3   4   5 
 * pin: B1  B2  B3  B7  D3  D2
 *
 * MCP23018
 * col: 0   1   2   3   4   5   6
 * pin: ~A0  A1  A2  A3  A4  A5  A6~
 */
static void unselect_cols(void) {
  // "no need to unselect on mcp23018, because the select step sets all
  // the other row bits high, and it's not changing to a different
  // direction"

  // unselect on teensy
  // LOW (DDR:1, PORT:0) to unselect
  DDRB	|= (1 << 7 | 1 << 3 | 1 << 2 | 1 << 1); // port B pins set to input (note '~')
  PORTB	&= ~(1 << 7 | 1 << 3 | 1 << 2 | 1 << 1); // port B pins Hi-Z instead of pullup

  DDRD	|= (1 << 3 | 1 << 2); // port D pins set to input (note '~')
  PORTD	&= ~(1 << 3 | 1 << 2); // port D pins Hi-Z instead of pullup
}

static void select_col(uint8_t col) {
  if (col < 0) {
    // select on mcp23018
    /*if (mcp23018_status) {  // if there was an error
                            // do nothing
    } else {
      // set active row low  : 0
      // set other rows hi-Z : 1
      mcp23018_status = i2c_start(I2C_ADDR_WRITE, ERGODOX_EZ_I2C_TIMEOUT);
      if (mcp23018_status) goto out;
      mcp23018_status = i2c_write(GPIOA, ERGODOX_EZ_I2C_TIMEOUT);
      if (mcp23018_status) goto out;
      mcp23018_status = i2c_write(0xFF & ~(1 << row), ERGODOX_EZ_I2C_TIMEOUT);
      if (mcp23018_status) goto out;
    out:
      i2c_stop();
    }*/
  } else {
	// Toggle LED?
	//PORTB = PORTB ^ 0x01;
/*
 * Teensy
 * col: 0   1   2   3   4   5 
 * pin: B1  B2  B3  B7  D3  D2
*/
    // select on teensy
    // Output HIGH(DDR:1, PORT:1) to select
    switch (col) {
      case 0:
        DDRB |= 0x02; // 0000_0001 -> 0000_0010 | DDRB,  
        PORTB |= 0x02;
        break;
      case 1:
        DDRB |= 0x04;
        PORTB |= 0x04;
        break;
      case 2:
        DDRB |= 0x08;
        PORTB |= 0x08;
        break;
      case 3:
        DDRB |= 0x80;
        PORTB |= 0x80;
        break;
      case 4:
        DDRD |= 0x08;
        PORTD |= 0x08;
        break;
      case 5:
        DDRD |= 0x04;
        PORTD |= 0x04;
        break;
    }
  }
}

/* Row pin configuration (dactyl's) 
 *
 * Teensy
 * row: 0   1   2   3   4   
 * pin: F0  F1  F4  F5  F6
 *
 * MCP23018
 * row: 0   1   2   3   4   5   6
 * pin: ~A0  A1  A2  A3  A4  A5  A6~
 */
