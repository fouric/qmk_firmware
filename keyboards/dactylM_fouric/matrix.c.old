*/

// Function prototypes unrelated to required functions
static matrix_col_t read_rows(uint8_t col);		// Read in columns
static void         init_rows(void); 			// Pin setups for rows
static void         unselect_cols(void);		// Disable column
static void         select_col(uint8_t col);	// Select column for scan


