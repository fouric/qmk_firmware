# Optional legacy toolchain image (Ubuntu 18.04 / gcc 7.5 / avr-gcc 5.4).
# Separate from Containerfile (qmk-dactylm). Prefer the main image for day-to-day
# firmware builds on modern QMK; keep this around if you need an older host
# compiler for unit tests or toolchain experiments.
#
# Build:
#   podman build -t qmk-dactylm-legacy -f Containerfile.legacy .
#
# Firmware:
#   podman run --rm -it -v "$PWD:/qmk_firmware:z" \
#     qmk-dactylm-legacy make dactylm_fouric:default

FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        avr-libc \
        binutils-avr \
        build-essential \
        ca-certificates \
        dfu-programmer \
        dfu-util \
        gcc-avr \
        git \
        libusb-dev \
        make \
        python3 \
        python3-pip \
        python3-setuptools \
        python3-venv \
        unzip \
        usbutils \
        wget \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY util/flash_teensy.sh /usr/local/bin/flash-teensy
COPY util/usb_test_teensy.sh /usr/local/bin/usb-test-teensy
RUN chmod 0755 /usr/local/bin/flash-teensy /usr/local/bin/usb-test-teensy

RUN git clone --depth 1 https://github.com/PaulStoffregen/teensy_loader_cli.git /tmp/teensy_loader_cli \
    && cd /tmp/teensy_loader_cli \
    && make \
    && install -m 0755 teensy_loader_cli /usr/local/bin/teensy_loader_cli \
    && rm -rf /tmp/teensy_loader_cli

RUN python3 -m venv /opt/qmk-venv
ENV PATH="/opt/qmk-venv/bin:${PATH}"

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /qmk_firmware
VOLUME ["/qmk_firmware"]

CMD ["sh", "-c", "echo 'Legacy image: gcc 7.5 + avr-gcc 5.4.0 (Ubuntu 18.04)' && echo 'Mount: -v \"$PWD:/qmk_firmware:z\"' && exec bash"]
